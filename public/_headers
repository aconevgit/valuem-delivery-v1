# Cloudflare Pages edge cache headers

# Security headers — applied to every response
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' static.cloudflareinsights.com plausible.io 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src embed.voomly.com; connect-src 'self' static.cloudflareinsights.com embed.voomly.com plausible.io; base-uri 'self'; form-action 'self'

# Astro build assets — content-hashed filenames, safe to cache forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts — long cache (1 year). Static filenames, but Cloudflare CDN cache
# is purged on every deployment so stale-font risk is deployment-scoped only.
# Browser cache is long but font updates are rare and always paired with a deploy.
/fonts/*
  Cache-Control: public, max-age=31536000

# Images — 24-hour cache with revalidation on deploy
/images/*
  Cache-Control: public, max-age=86400
/og-image.png
  Cache-Control: public, max-age=86400
/video-thumbnail.webp
  Cache-Control: public, max-age=86400
/video-thumbnail-960.webp
  Cache-Control: public, max-age=86400
/favicon-colour.svg
  Cache-Control: public, max-age=86400

# HTML pages — always revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
/blog
  Cache-Control: public, max-age=0, must-revalidate
/blog/*
  Cache-Control: public, max-age=0, must-revalidate

# Sitemap and robots — 1-hour cache
/sitemap-index.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
