---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CtaFooter from '../components/CtaFooter.astro';
import Footer from '../components/Footer.astro';
---

<Layout canonicalPath="/">
    <Header />

    <main>
        <section class="hero">
            <div class="container">
                <p class="pre-heading">For CEOs and Founders</p>
                <h1>Business growth strategies that work when your team stops working</h1>
                <p class="hero-subheading">ValueM™ helps founders between $3M and $10M fix their business performance, scale without the chaos, and do it without hiring more people.</p>
                <div class="button-group">
                    <a href="#video-section" class="primary-button">Fix my performance → </a>
                    <a href="#symptoms-section" class="secondary-button">Spot the 3 symptoms</a>
                </div>
            </div>
        </section>

        <section id="symptoms-section" class="symptoms">
    <div class="container">
        <h2>The hidden cost of growing too fast</h2>
        <p class="symptoms-subheading">Most founders expect company growth to get easier over time. It does not. Growing your business past the 3 million mark introduces a specific kind of complexity that nobody warned you about. Your team is capable, your product works, and yet everything feels slower and harder than it used to be. This is not a people problem, and this is not a tool problem. It is an architectural problem.</p>


        <ul class="symptoms-list">
            <li><div class="symptom-text">No one on your team says "No" to a client.</div></li>
            <li><div class="symptom-text">Every difficult conversation falls to you.</div></li>
            <li><div class="symptom-text">You keep hiring. It keeps getting slower.</div></li>
        </ul>
    </div>
</section>

        <section id="video-section" class="video-section">
            <div class="container">
                <h2>Two minutes &middot; Three problems &middot; One system</h2>
                <p class="video-subheading">Watch how companies like yours close the delivery gap for good.</p>
                <div class="video-wrapper" id="video-container" role="button" tabindex="0" aria-label="Play Value M client delivery system video">
                    <img
                        src="/video-thumbnail.webp"
                        srcset="/video-thumbnail-960.webp 960w, /video-thumbnail.webp 1920w"
                        sizes="(min-width: 1008px) 960px, calc(100vw - 48px)"
                        alt="Value M video on scaling a business past $3M"
                        class="video-thumbnail"
                        width="1920"
                        height="1080"
                        loading="lazy"
                    >
                    <button class="play-button" aria-label="Play Value M client delivery system video"></button>
                    <iframe id="voomly-iframe" src="" style="display: none; border: none;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen title="Value M Client Delivery System Video"></iframe>
                </div>
            </div>
        </section>

        <section id="clients" class="testimonials">
            <div class="container">
                <h2>Proven across industries</h2>
                <p class="testimonials-subheading">Different sectors. Different sizes. The same fix.</p>
                <div class="testimonials-grid">
                    <div class="testimonial-card">
                        <p class="testimonial-label">Fintech</p>
                        <p class="testimonial-quote">Designed a requirements documentation and scope control framework. Implementation time was reduced from eight months to six across all subsequent client engagements.</p>
                        <p class="testimonial-name">Aleksandar Alexiev</p>
                        <p class="testimonial-title">Co-Founder, Finrelay</p>
                    </div>
                    <div class="testimonial-card">
                        <p class="testimonial-label">iGaming</p>
                        <p class="testimonial-quote">Designed a repeatable client engagement and onboarding framework for a heavily customised B2B Crypto igaming platform. First structured onboarding reduced setup time by three weeks.</p>
                        <p class="testimonial-name">Tobias Fogelberg</p>
                        <p class="testimonial-title">COO, Cubeia Sweden AB</p>
                    </div>
                    <div class="testimonial-card">
                        <p class="testimonial-label">Property Management</p>
                        <p class="testimonial-quote">Full-day workshop rebuilding the client-facing methodology for account managers managing complex long-term relationships in the German property market.</p>
                        <p class="testimonial-name">Sergey Koynov</p>
                        <p class="testimonial-title">Chief Executive Officer, Intelliway Services</p>
                    </div>
                </div>
            </div>
        </section>
        <CtaFooter />
    </main>

    <Footer />
</Layout>

<style>
    .hero {
        background-color: var(--color-bg);
        padding: 64px 0;
    }
    .hero h1 {
        font-size: 46px;
        font-weight: 800;
        line-height: 1.15;
        margin-bottom: 24px;
    }
    .hero-subheading {
        font-size: 24px;
        font-weight: 400;
        color: var(--color-text-light);
        margin-bottom: 40px;
        line-height: 1.7;
    }
    .button-group {
        display: flex;
        flex-direction: column;
        gap: 20px;
        width: fit-content;
    }
    .primary-button, .secondary-button {
        padding: 14px 36px;
        text-decoration: none;
        font-weight: 600;
        font-size: 16px;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius);
        white-space: nowrap;
        transition: transform var(--transition), box-shadow var(--transition), background-color var(--transition), color var(--transition);
    }
    .primary-button {
        background-color: var(--color-primary);
        color: var(--color-bg);
    }
    .primary-button:hover {
        transform: scale(1.02);
        box-shadow: 0 8px 16px rgba(0, 31, 100, 0.15);
    }
    .secondary-button {
        background-color: transparent;
        color: var(--color-primary);
        border: 2px solid var(--color-primary);
    }
    .secondary-button:hover {
        background-color: var(--color-primary);
        color: var(--color-bg);
        transform: scale(1.02);
        box-shadow: 0 8px 16px rgba(0, 31, 100, 0.15);
    }
    .symptoms {
        background-color: var(--color-bg-alt);
        padding: 48px 0;
        scroll-margin-top: 64px;
    }
    .symptoms h2 {
        font-size: 32px;
        font-weight: 700;
        line-height: 1.15;
        margin-bottom: 20px;
    }
    .symptoms-subheading {
        font-size: 22px;
        font-weight: 400;
        color: var(--color-text-light);
        margin-bottom: 28px;
        line-height: 1.7;
    }
    .symptoms-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
        list-style: none;
    }
    .symptoms-list li {
        display: flex;
        align-items: center;
        background-color: var(--color-bg);
        border: 1px solid var(--color-border);
        padding: 28px 32px;
    }
    .symptom-text {
        font-size: 18px;
        font-weight: 600;
        line-height: 1.4;
        color: var(--color-text);
    }
    @media (min-width: 768px) {
        .symptoms-list { grid-template-columns: repeat(3, 1fr); gap: 24px; }
    }
    .video-section {
        background-color: var(--color-bg);
        padding: 48px 0;
        scroll-margin-top: 64px;
    }
    .video-section h2 {
        font-size: 28px;
        font-weight: 700;
        line-height: 1.15;
        margin-bottom: 20px;
    }
    .video-subheading {
        font-size: 22px;
        font-weight: 400;
        color: var(--color-text-light);
        margin-bottom: 32px;
        line-height: 1.7;
    }
    .video-wrapper {
        position: relative;
        width: 100%;
        padding-top: 56.25%;
        cursor: pointer;
    }
    .video-thumbnail {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        object-fit: cover;
        display: block;
        transition: opacity 0.3s ease-out;
    }
    .video-thumbnail.hidden { opacity: 0; pointer-events: none; }
    .play-button {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 80px; height: 80px;
        background-color: var(--color-primary);
        border: none;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        transition: transform 0.2s ease-out, box-shadow 0.2s ease-out;
    }
    .play-button:hover {
        transform: translate(-50%, -50%) scale(1.1);
        box-shadow: 0 12px 24px rgba(0, 31, 100, 0.25);
    }
    .play-button::after {
        content: '';
        width: 0; height: 0;
        border-left: 28px solid var(--color-bg);
        border-top: 18px solid transparent;
        border-bottom: 18px solid transparent;
        margin-left: 4px;
    }
    .play-button.hidden { opacity: 0; pointer-events: none; }
    .video-wrapper iframe {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
    }
    .testimonials {
        background-color: var(--color-bg-alt);
        padding: 48px 0;
    }
    .testimonials h2 {
        font-size: 28px;
        font-weight: 700;
        line-height: 1.15;
        margin-bottom: 20px;
    }
    .testimonials-subheading {
        font-size: 22px;
        font-weight: 400;
        color: var(--color-text-light);
        margin-bottom: 28px;
        line-height: 1.7;
    }
    .testimonials-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 32px;
    }
    .testimonial-card {
        background-color: var(--color-bg);
        border: 1px solid var(--color-border);
        padding: 40px;
    }
    .testimonial-label {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        color: var(--color-primary);
        margin-bottom: 16px;
    }
    .testimonial-quote {
        font-size: 16px;
        font-weight: 400;
        line-height: 1.7;
        margin-bottom: 20px;
    }
    .testimonial-name {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 4px;
    }
    .testimonial-title {
        font-size: 14px;
        font-weight: 400;
        color: var(--color-text-muted);
    }
    @media (min-width: 768px) {
        .button-group { flex-direction: row; gap: 24px; }
    }
    @media (min-width: 1024px) {
        .hero { padding: 80px 0; }
        .hero h1 { font-size: 64px; }
        .symptoms { padding: 72px 0; }
        .symptoms h2 { font-size: 46px; }
        .video-section { padding: 80px 0; }
        .video-section h2 { font-size: 40px; }
        .testimonials { padding: 72px 0; }
        .testimonials h2 { font-size: 40px; }
        .testimonials-grid { grid-template-columns: repeat(3, 1fr); }
    }
</style>

<script>
    const videoWrapper = document.getElementById('video-container') as HTMLElement | null;
    const playButton = document.querySelector('.play-button');
    const videoThumbnail = document.querySelector('.video-thumbnail');
    const voomlyIframe = document.getElementById('voomly-iframe') as HTMLIFrameElement | null;

    if (videoWrapper && playButton && videoThumbnail && voomlyIframe) {
        const voomlyUrl = 'https://embed.voomly.com/embed/assets/embed.html?videoId=moqpVkfUncEEiFlO1s1i4DePhUldHVdc4Ny8GYBPPzLR1j1sU&videoRatio=1.777778&type=v&skinColor=rgba(0%2C31%2C100%2C1)';

        function playVideo() {
            voomlyIframe.src = voomlyUrl;
            voomlyIframe.style.display = 'block';
            videoThumbnail.classList.add('hidden');
            playButton.classList.add('hidden');
            videoWrapper.removeAttribute('tabindex');
            videoWrapper.removeAttribute('role');
        }

        videoWrapper.addEventListener('click', playVideo);
        videoWrapper.addEventListener('keydown', (e: KeyboardEvent) => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                playVideo();
            }
        });
    }
</script>
