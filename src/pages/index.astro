---
// ValueMDelivery.com — Landing Page
// Calendly: https://calendly.com/conev/value-m-client-facing-discovery
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="robots" content="index, follow" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
        <title>ValueM Delivery | Fix Your Client-Facing</title>
        <meta name="description" content="Good product. Great team. Losing clients. You are missing one thing. It is fixable in 30 days." />
        <meta name="theme-color" content="#ffffff" />
        <link rel="canonical" href="https://valuemdelivery.com/" />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://valuemdelivery.com/" />
        <meta property="og:title" content="ValueM Delivery | Fix Your Client-Facing" />
        <meta property="og:description" content="Good product. Great team. Losing clients. Book a free 30-minute call." />

        <!-- Twitter / X -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="ValueM Delivery | Fix Your Client-Facing" />
        <meta name="twitter:description" content="Good product. Great team. Losing clients. Book a free 30-minute call." />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

        <style>
/* ===== 1. TOKENS ===== */
:root {
    color-scheme: light;

    --color-brand:             #4f46e5;
    --color-brand-hover:       #4338ca;
    --color-brand-light:       #818cf8;
    --color-brand-glow-soft:   rgba(79, 70, 229, 0.35);
    --color-brand-glow-faint:  rgba(79, 70, 229, 0.04);
    --color-brand-glow-pulse:  rgba(79, 70, 229, 0.3);
    --color-brand-light-alpha: rgba(129, 140, 248, 0.4);
    --color-brand-light-soft:  rgba(129, 140, 248, 0.2);
    --color-brand-light-hover: #c7d2fe;

    --color-surface-dark:    #0f1117;
    --color-card-dark:       #1a1f2e;
    --color-bg-primary:      #ffffff;
    --color-bg-secondary:    #f8fafc;
    --color-bg-nav:          rgba(255, 255, 255, 0.95);
    --color-bg-testimonials: #e8edf5;
    --color-bg-avatar:       #e2e8f0;
    --color-bg-dot:          #cbd5e1;

    --color-text-primary:    #0b0b0f;
    --color-text-muted:      #6c727f;
    --color-text-dark-muted: #94a3b8;
    --color-text-on-dark:    #ffffff;
    --color-text-subtle:     #4b5563;
    --color-text-hero:       #3b4458;
    --color-text-muted-light:#5b677b;
    --color-text-section:    #5b677b;
    --color-text-footer:     #7e8a98;
    --color-text-footer-logo:#eef2ff;
    --color-avatar-initials: #1e293b;

    --color-border:            #eceef2;
    --color-border-dark:       rgba(255, 255, 255, 0.06);
    --color-border-dark-hover: rgba(255, 255, 255, 0.12);
    --color-border-light:      #e2e8f0;
    --color-video-border:      #eef2f6;

    --color-shadow-nav:    rgba(0, 0, 0, 0.12);
    --color-shadow-sm:     rgba(0, 0, 0, 0.02);
    --color-shadow-avatar: rgba(0, 0, 0, 0.05);

    --radius-pill:      40px;
    --radius-card:      16px;
    --radius-card-sm:   14px;
    --radius-card-dark: 14px;
    --radius-card-pain: 20px;

    --transition-base: 0.2s ease;
    --duration-slow:   0.4s;
}

/* ===== 2. RESET ===== */
* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }

/* ===== 3. BODY ===== */
body {
    font-family: "Inter", system-ui, -apple-system, sans-serif;
    background: var(--color-bg-secondary);
    color: var(--color-text-primary);
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* ===== 4. CONTAINER ===== */
.container {
    width: 100%;
    margin: 0 auto;
    padding: 0 20px;
}

/* ===== 5. NAVIGATION ===== */
.nav-section {
    background: var(--color-bg-nav);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--color-shadow-nav);
    position: sticky;
    top: 0;
    z-index: 60;
}

.nav { padding: 16px 0; }

.nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.015em;
    text-decoration: none;
    color: var(--color-text-primary);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
}

.nav-cta-text {
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-text-on-dark);
    transition: background var(--transition-base), color var(--transition-base), border-color var(--transition-base), transform var(--transition-base);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--color-text-primary);
    border: 1.5px solid transparent;
    cursor: pointer;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
}

.nav-cta-text:hover {
    background: transparent;
    color: var(--color-text-subtle);
    border-color: var(--color-text-subtle);
    transform: scale(1.03);
}

/* ===== 6. HERO ===== */
.hero-section {
    background: var(--color-bg-primary);
    padding: 100px 0 96px;
    text-align: center;
    border-bottom: 1px solid var(--color-border);
}

.eyebrow {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.4px;
    color: var(--color-brand);
    margin-bottom: 20px;
    display: inline-block;
}

.hero-title {
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-text-primary);
    max-width: 960px;
    margin: 0 auto 24px auto;
}

.hero-supporting-text {
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-text-hero);
    max-width: 840px;
    margin: 0 auto 40px auto;
    padding: 0 4px;
}

.hero-cta-group {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    align-items: center;
}

.btn-primary {
    background: var(--color-brand);
    color: white;
    padding: 14px 32px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: transform var(--transition-base), box-shadow var(--transition-base), background var(--transition-base);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
}

.btn-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 0 0 8px var(--color-brand-glow-pulse);
    opacity: 0;
    animation: pulse-glow 2s infinite;
    pointer-events: none;
}

.btn-primary:hover {
    background: var(--color-brand-hover);
    transform: scale(1.03);
    box-shadow: 0 8px 24px var(--color-brand-glow-soft);
}

@keyframes pulse-glow {
    0%, 100% { opacity: 0; transform: scale(1); }
    50%       { opacity: 1; transform: scale(1.15); }
}

.ghost-link {
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-text-subtle);
    transition: border-color var(--transition-base), color var(--transition-base), transform var(--transition-base), background var(--transition-base);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: 1.5px solid var(--color-border-light);
    cursor: pointer;
    padding: 14px 32px;
    border-radius: var(--radius-pill);
}

.ghost-link:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
    transform: scale(1.03);
    background: var(--color-brand-glow-faint);
}

.hero-note {
    margin-top: 20px;
    font-size: 13px;
    color: var(--color-text-muted);
    text-align: center;
}

/* ===== 7. PAIN ===== */
.pain-section {
    background: var(--color-surface-dark);
    padding: 96px 0;
    border-bottom: 1px solid var(--color-border-dark);
}

.pain-section .section-header h2 { color: var(--color-text-on-dark); }
.pain-section .section-header p  { color: var(--color-text-dark-muted); }

.section-header {
    text-align: center;
    margin-bottom: 64px;
}

.section-header h2 {
    font-size: 32px;
    font-weight: 700;
    color: var(--color-text-primary);
    max-width: 960px;
    margin: 0 auto 16px;
}

.section-header p {
    font-size: 16px;
    color: var(--color-text-section);
    max-width: 840px;
    margin: 0 auto;
    padding: 0 12px;
}

.pain-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    max-width: 960px;
    margin: 0 auto;
}

.pain-card {
    background: var(--color-card-dark);
    border-radius: var(--radius-card-pain);
    padding: 40px 32px;
    border: 1px solid var(--color-border-dark);
    transition: border-color var(--transition-base);
    text-align: left;
}

.pain-card:hover { border-color: var(--color-border-dark-hover); }

.pain-number {
    font-size: 48px;
    font-weight: 800;
    color: var(--color-brand-light);
    line-height: 1.1;
    margin-bottom: 16px;
}

.pain-label {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-text-on-dark);
    margin-bottom: 14px;
}

.pain-desc {
    font-size: 16px;
    color: var(--color-text-dark-muted);
    line-height: 1.4;
}

/* ===== 8. VIDEO ===== */
.video-section {
    background: var(--color-bg-primary);
    padding: 96px 0;
    border-bottom: 1px solid var(--color-border);
}

.video-wrapper {
    max-width: 100%;
    margin: 0 auto;
    border-radius: var(--radius-card);
    background: var(--color-surface-dark);
    border: 1px solid var(--color-video-border);
    box-shadow: 0 1px 2px var(--color-shadow-sm);
    overflow: hidden;
    position: relative;
    aspect-ratio: 16 / 9;
}

.video-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: none;
}

.video-facade {
    position: absolute;
    inset: 0;
    cursor: pointer;
    transition: opacity var(--duration-slow) ease;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-dark);
}

.video-facade.hidden {
    opacity: 0;
    pointer-events: none;
}

.video-play-btn {
    width: 72px;
    height: 72px;
    background: var(--color-brand);
    border-radius: 50%;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition-base), transform var(--transition-base);
}

.video-play-btn:hover {
    background: var(--color-brand-hover);
    transform: scale(1.08);
}

.video-play-btn::after {
    content: "";
    display: block;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 10px 0 10px 18px;
    border-color: transparent transparent transparent #ffffff;
    margin-left: 4px;
}

.video-caption {
    text-align: center;
    margin: 28px auto 0;
    font-size: 13px;
    color: var(--color-text-muted);
    max-width: 960px;
}

/* ===== 9. TESTIMONIALS ===== */
.social-proof-section {
    background: var(--color-bg-testimonials);
    padding: 96px 0;
    border-bottom: 1px solid var(--color-border);
}

.testimonial-container {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    position: relative;
}

.testimonial-slide {
    display: none;
    animation: fadeIn 0.5s ease-in-out;
}

.testimonial-slide.active {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
}

.testimonial-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex-shrink: 0;
}

.testimonial-right {
    width: 100%;
    text-align: center;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
}

.testimonial-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-bg-avatar);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 2px solid #ffffff;
    box-shadow: 0 2px 6px var(--color-shadow-avatar);
}

.testimonial-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.avatar-initials {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-avatar-initials);
}

.testimonial-stars {
    color: var(--color-brand);
    font-size: 18px;
    margin-bottom: 16px;
}

.testimonial-quote {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-text-primary);
    margin-bottom: 32px;
}

.testimonial-quote::before {
    content: "\275D";
    font-size: 1.4em;
    color: var(--color-brand);
    margin-right: 4px;
}

.testimonial-quote::after {
    content: "\275E";
    font-size: 1.4em;
    color: var(--color-brand);
    margin-left: 4px;
    vertical-align: top;
}

.testimonial-left cite { display: block; text-align: center; }

.testimonial-author {
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 4px;
    font-size: 16px;
}

.testimonial-title {
    font-size: 13px;
    color: var(--color-text-muted);
}

.testimonial-dots {
    display: flex;
    justify-content: center;
    gap: 28px;
    margin-top: 48px;
}

.dot {
    width: 10px;
    height: 10px;
    background: var(--color-bg-dot);
    border-radius: 50%;
    cursor: pointer;
    transition: background var(--transition-base), width var(--transition-base), border-radius var(--transition-base);
    border: none;
    padding: 8px;
    margin: -8px;
}

.dot.active {
    background: var(--color-brand);
    width: 24px;
    border-radius: calc(var(--radius-pill) * 0.3);
}

.dot:hover { background: var(--color-brand); }

/* ===== 10. FOOTER ===== */
.footer-section {
    background: var(--color-surface-dark);
    color: var(--color-bg-avatar);
    padding: 16px 0;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

.footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
}

.footer-logo {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-text-footer-logo);
    text-decoration: none;
    letter-spacing: -0.01em;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.footer-copyright {
    font-size: 13px;
    color: var(--color-text-footer);
}

/* ===== 11. REVEAL ANIMATIONS ===== */
.reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s cubic-bezier(0.25, 0.1, 0.25, 1),
                transform 0.5s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
}

.reveal-delay-1 { transition-delay: 80ms; }
.reveal-delay-2 { transition-delay: 160ms; }
.reveal-delay-3 { transition-delay: 240ms; }

/* ===== 12. FOCUS VISIBLE ===== */
:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
    border-radius: 4px;
}

.btn-primary:focus-visible,
.nav-cta-text:focus-visible {
    outline: 2px solid var(--color-text-on-dark);
    outline-offset: 3px;
}

.dot:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
}

/* ===== 13. REDUCED MOTION ===== */
@media (prefers-reduced-motion: reduce) {
    .btn-primary { animation: none; }
    .testimonial-slide { animation: none; }
    .reveal { opacity: 1; transform: none; transition: none; }
    * { transition-duration: 0.01ms !important; }
}

/* ===== 14. RESPONSIVE ===== */
@media (min-width: 480px) {
    .testimonial-quote  { font-size: 20px; }
    .testimonial-avatar { width: 80px; height: 80px; }
    .avatar-initials    { font-size: 22px; }
}

@media (min-width: 640px) {
    .pain-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .pain-section  { padding: 120px 0; }
    .video-section { padding: 120px 0; }
    .social-proof-section { padding: 120px 0; }
    .nav-cta-text  { font-size: 15px; }
    .nav           { padding: 20px 0; }
    .logo          { font-size: 16px; }
    .hero-section  { padding: 120px 0; }
    .hero-title    { font-size: 50px; }
    .hero-supporting-text { font-size: 18px; }
    .eyebrow       { font-size: 13px; }
    .btn-primary   { padding: 16px 40px; font-size: 16px; }
    .ghost-link    { padding: 16px 40px; font-size: 16px; }
    .pain-number   { font-size: 60px; }
    .pain-label    { font-size: 20px; }
    .pain-desc     { font-size: 17px; }
    .section-header p  { font-size: 18px; }
    .section-header h2 { font-size: 36px; }
    .testimonial-quote  { font-size: 22px; }
    .testimonial-avatar { width: 88px; height: 88px; }
    .avatar-initials    { font-size: 26px; }
    .testimonial-slide.active {
        flex-direction: row;
        align-items: center;
        gap: 48px;
    }
    .testimonial-right { flex: 1; text-align: left; }
    .footer-section { padding: 20px 0; }
    .footer-copyright { font-size: 14px; }
    .footer-logo      { font-size: 14px; }
    .container { padding: 0 24px; }
}

@media (min-width: 768px) {
    .container { max-width: 960px; padding: 0 24px; }
    .hero-title { font-size: 58px; }
    .section-header h2 { font-size: 38px; }
    .pain-grid { grid-template-columns: repeat(3, 1fr); gap: 28px; }
}

@media (min-width: 1024px) {
    .container { max-width: 960px; padding: 0 20px; }
    .nav-cta-text { font-size: 16px; }
    .hero-section  { padding: 160px 0 140px; }
    .pain-section  { padding: 160px 0; }
    .video-section { padding: 160px 0; }
    .social-proof-section { padding: 160px 0; }
    .hero-title    { font-size: 65px; }
    .hero-supporting-text { font-size: 24px; }
    .eyebrow       { font-size: 14px; }
    .pain-number   { font-size: 72px; }
    .pain-label    { font-size: 22px; }
    .pain-desc     { font-size: 18px; }
    .section-header p  { font-size: 20px; }
    .section-header h2 { font-size: 42px; }
    .footer-section    { padding: 20px 0; }
    .footer-copyright  { font-size: 15px; }
    .footer-logo       { font-size: 15px; }
}
        </style>
    </head>
    <body>

        <!-- NAVIGATION -->
        <nav class="nav-section" aria-label="Main navigation">
            <div class="container">
                <div class="nav">
                    <div class="nav-inner">
                        <a href="/" class="logo">
                            <img src="/logo2.svg" alt="ValueM Delivery" height="28" style="width:auto;display:block;">
                        </a>
                        <a href="https://calendly.com/conev/value-m-client-facing-discovery" target="_blank" class="nav-cta-text">
                            Book a Call<span aria-hidden="true">→</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>

        <!-- HERO -->
        <section class="hero-section" aria-labelledby="hero-heading">
            <div class="container">
                <p class="eyebrow">Client Delivery for Growing Businesses</p>
                <h1 id="hero-heading" class="hero-title">
                    Good product. Great team.<br>Losing clients.
                </h1>
