---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { readingTime } from '../../utils/readingTime';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog | Value M" description="Insights on client-facing delivery, leadership, and business scaling for CEOs and founders." canonicalPath="/blog">
  <Header />

  <main>
    <section class="blog-hero">
      <div class="container">
        <p class="pre-heading">Insights</p>
        <p class="hero-subheading">Practical thinking on client-facing delivery, team performance, and business scaling. No methodology lectures. No filler.</p>
      </div>
    </section>

    <section class="post-list-section">
      <div class="container">
        {posts.length === 0 ? (
          <p class="empty-state">No posts yet. Check back soon.</p>
        ) : (
          <ul class="post-list">
            {posts.map(post => (
              <li class="post-card">
                <a href={`/blog/${post.data.slug ?? post.id.replace(/\.mdx?$/, '')}`}>
                  <div class="post-meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
                    </time>
                    <span class="separator">·</span>
                    <span class="reading-time">{readingTime(post.body ?? '')}</span>
                  </div>
                  <h2 class="post-title">{post.data.title} <span class="arrow">&rarr;</span></h2>
                  <p class="post-description">{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .blog-hero {
    background-color: var(--color-bg-alt);
    padding: 40px 0 32px;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-subheading {
    font-size: 24px;
    font-weight: 400;
    color: var(--color-text-light);
    line-height: 1.7;
    max-width: 680px;
  }

  .post-list-section {
    padding: 0 0 40px;
    background-color: var(--color-bg);
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .post-card {
    border-bottom: 1px solid var(--color-border);
  }

  .post-card a {
    display: block;
    padding: 40px 0;
    text-decoration: none;
    color: var(--color-text);
    transition: opacity var(--transition);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  time {
    font-size: 14px;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .separator {
    color: var(--color-text-muted);
    font-size: 14px;
  }

  .reading-time {
    font-size: 14px;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .post-title {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 12px;
    max-width: 680px;
    color: var(--color-text);
    transition: color var(--transition);
  }

  .post-card a:hover .post-title {
    color: var(--color-primary);
  }

  .arrow {
    display: inline-block;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity var(--transition), transform var(--transition);
    font-weight: 400;
  }

  .post-card a:hover .arrow {
    opacity: 1;
    transform: translateX(2px);
  }

  .post-description {
    font-size: 17px;
    font-weight: 400;
    color: var(--color-text-light);
    line-height: 1.7;
    max-width: 680px;
  }

  .empty-state {
    font-size: 17px;
    color: var(--color-text-muted);
    padding: 64px 0;
  }

  @media (min-width: 1024px) {
    .blog-hero {
      padding: 56px 0 48px;
    }

    .post-list-section {
      padding: 0 0 48px;
    }

    .post-title {
      font-size: 28px;
    }
  }
</style>
