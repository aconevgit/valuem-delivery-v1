---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const slug = post.id.replace(/\.mdx?$/, '');
const SITE_URL = 'https://valuemdelivery.com';
const postUrl = `${SITE_URL}/blog/${slug}`;
const author = post.data.author ?? 'Value M';
const resolvedOgImage = post.data.ogImage ?? `${SITE_URL}/og-image.png`;
const modifiedDate = post.data.updatedDate ?? post.data.pubDate;

function readingTime(body: string) {
  const words = body.trim().split(/\s+/).length;
  const minutes = Math.ceil(words / 200);
  return `${minutes} min read`;
}

const wordCount = (post.body ?? '').trim().split(/\s+/).length;

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': postUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  headline: post.data.title,
  description: post.data.description,
  image: {
    '@type': 'ImageObject',
    url: resolvedOgImage,
  },
  datePublished: post.data.pubDate.toISOString(),
  dateModified: modifiedDate.toISOString(),
  inLanguage: 'en',
  wordCount,
  url: postUrl,
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Value M',
    url: SITE_URL,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/favicon-colour.svg`,
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog` },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: postUrl },
  ],
};

const schema = JSON.stringify([blogPostingSchema, breadcrumbSchema]);
---

<Layout
  title={`${post.data.title} | Value M`}
  description={post.data.description}
  ogType="article"
  canonicalPath={`/blog/${slug}`}
  ogImage={post.data.ogImage}
  articleDate={post.data.pubDate.toISOString()}
  articleModifiedDate={modifiedDate.toISOString()}
  articleAuthor={author}
  articleSection={post.data.category}
  articleTags={post.data.tags}
  schema={schema}
>
  <Header />

  <main>
    <article>
      <header class="post-header">
        <div class="container">
          <div class="post-header-inner">
            <a href="/blog" class="back-link"><span aria-hidden="true">&larr;</span> All articles</a>
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
              <span class="separator">·</span>
              <span class="reading-time">{readingTime(post.body ?? '')}</span>
              {post.data.author && (
                <>
                  <span class="separator">·</span>
                  <span class="author">{post.data.author}</span>
                </>
              )}
            </div>
            <h1>{post.data.title}</h1>
            <p class="post-description">{post.data.description}</p>
          </div>
        </div>
      </header>

      <div class="post-body">
        <div class="container">
          <div class="content">
            <Content />
          </div>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<style>
  .post-header {
    background-color: var(--color-bg-alt);
    padding: 40px 0 28px;
    border-bottom: 1px solid var(--color-border);
  }

  .post-header-inner {
    max-width: 680px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    margin-bottom: 16px;
    transition: opacity var(--transition);
  }

  .back-link:hover {
    opacity: 0.7;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }

  time, .reading-time, .author {
    font-size: 14px;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .separator {
    color: var(--color-text-muted);
    font-size: 14px;
  }

  .post-header h1 {
    font-size: 40px;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 20px;
    color: var(--color-text);
  }

  .post-description {
    font-size: 22px;
    font-weight: 400;
    color: var(--color-text-light);
    line-height: 1.7;
  }

  .post-body {
    padding: 28px 0 48px;
  }

  .content {
    max-width: 680px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-text);
  }

  .content :global(p) {
    margin-bottom: 28px;
  }

  .content :global(h2) {
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
    margin-top: 56px;
    margin-bottom: 16px;
    color: var(--color-text);
  }

  .content :global(h3) {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
    margin-top: 40px;
    margin-bottom: 12px;
    color: var(--color-text);
  }

  .content :global(ul), .content :global(ol) {
    padding-left: 24px;
    margin-bottom: 28px;
  }

  .content :global(li) {
    margin-bottom: 8px;
  }

  .content :global(strong) {
    font-weight: 700;
    color: var(--color-text);
  }

  .content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .content :global(a:hover) {
    opacity: 0.7;
  }

  .content :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 40px 0;
  }

  .content :global(blockquote) {
    border-left: 3px solid var(--color-primary);
    padding-left: 24px;
    margin: 40px 0;
    font-size: 20px;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.5;
  }

  @media (min-width: 1024px) {
    .post-header {
      padding: 56px 0 40px;
    }

    .post-header h1 {
      font-size: 52px;
    }

    .post-body {
      padding: 40px 0 56px;
    }

    .content {
      font-size: 18px;
    }
  }
</style>
